# Copiar a .env y completar. .env no se sube al repo.
# Dominio del equipo: fraude | tarifario | tarjetas | prestamos | atencion
DOMAIN=fraude
MAX_TURNS=10

# Sesión 1 (mock): tal cual, con `uv run python dev/mock_foundry.py` en otra terminal
# Sesión 2 (Foundry con Entra ID): `az login` y luego
#   FOUNDRY_ENDPOINT=https://<recurso>.openai.azure.com   (recurso > Claves y punto de conexión)
#   FOUNDRY_AUTH_PROVIDER=entra_id
#   FOUNDRY_API_KEY=                                      (vacío)
FOUNDRY_ENDPOINT=http://127.0.0.1:8100
FOUNDRY_DEPLOYMENT=gpt-5-mini
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Provider de autenticación contra Foundry: api_key | entra_id
#   api_key  -> usa FOUNDRY_API_KEY: el mock, o un token temporal de Cloud Shell
#               (az account get-access-token --resource https://cognitiveservices.azure.com)
#   entra_id -> DefaultAzureCredential (az login en local, Managed Identity desplegado);
#               requiere rol "Cognitive Services OpenAI User" en el recurso
FOUNDRY_AUTH_PROVIDER=api_key
FOUNDRY_API_KEY=fake-token

FOUNDRY_TIMEOUT_S=30
FOUNDRY_MAX_RETRIES=2

# Sesión 3 (ingesta): el corpus va en data/corpus/<DOMAIN>/ (data/ no se versiona)
#   uv run ingest build    corpus -> data/chunks/<DOMAIN>.json
#   uv run ingest publish  chunks -> índice local data/index/<DOMAIN>.json
INGEST_CHUNK_MAX_CHARS=1500
